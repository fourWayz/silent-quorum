// Silent Quorum — Quorum Core.
// Atomic threshold-ignition protocol: anonymous, issuer-unlinkable pledges,
// domain-separated nullifiers, same-transaction threshold consequence.
//
// This is the protocol's cryptographic heart. Everything below stays in one
// circuit, one transaction, one proof — verified empirically on live devnet
// (see ARCHITECTURE.md) that the network itself, not just this contract's
// own guard, rejects a pledge proved against stale state. Nothing here may
// move into another contract.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---- Public (sealed) configuration, fixed at construction ----
export sealed ledger org_id: Bytes<32>;
export sealed ledger quorum_id: Bytes<32>;
export sealed ledger action_id: Bytes<32>;
export sealed ledger threshold: Uint<32>;
export sealed ledger issuer_commitment: Bytes<32>;
export sealed ledger consequence_recipient_commitment: Bytes<32>;
export sealed ledger consequence_amount: Uint<64>;
export sealed ledger protocol_version: Uint<16>;
// Deterministic hash of every field above — independently reproducible by
// any client from the same constructor arguments. This is what the Registry
// records for later cross-referencing (see ARCHITECTURE.md, §"client-verified").
export sealed ledger config_commitment: Bytes<32>;

// ---- Public protocol state ----
export ledger eligibility_tree: HistoricMerkleTree<10, Bytes<32>>;
export ledger pledge_nullifiers: Map<Bytes<32>, Boolean>;
export ledger tally: Counter;
export ledger fired: Boolean;
export ledger consequence_balance: Uint<64>;
// Lifecycle: both one-way. No expiration/deadline exists — Compact 0.31.1
// has no trustworthy on-chain clock, so lifecycle here is action-triggered
// (an authorized call), never time-triggered.
export ledger registration_open: Boolean;
export ledger cancelled: Boolean;

constructor(
  org: Bytes<32>,
  quorum: Bytes<32>,
  action: Bytes<32>,
  thresholdIn: Uint<32>,
  issuerCommitment: Bytes<32>,
  recipientCommitment: Bytes<32>,
  amount: Uint<64>
) {
  // Every constructor parameter is compiler-tainted until disclosed, even
  // ordinary public config (verified empirically against 0.31.1).
  org_id = disclose(org);
  quorum_id = disclose(quorum);
  action_id = disclose(action);
  threshold = disclose(thresholdIn);
  issuer_commitment = disclose(issuerCommitment);
  consequence_recipient_commitment = disclose(recipientCommitment);
  consequence_amount = disclose(amount);
  protocol_version = 2;

  config_commitment = persistentHash<Vector<9, Bytes<32>>>([
    pad(32, "silent-quorum:config:"),
    org_id,
    quorum_id,
    action_id,
    threshold as Field as Bytes<32>,
    issuer_commitment,
    consequence_recipient_commitment,
    consequence_amount as Field as Bytes<32>,
    protocol_version as Field as Bytes<32>
  ]);

  fired = false;
  consequence_balance = 0;
  registration_open = true;
  cancelled = false;
}

// ---- Issuer authorization ----
// A shared-secret role gate, not public-key signature authorization: no
// signature-verification API exists in Compact 0.31.1 (verified empirically —
// neither secp256k1EcdsaVerify nor jubjubSchnorrVerify resolve). Whoever
// knows issuerSecret can register, close registration, or cancel. This is a
// real, named limitation, not a placeholder for something stronger.
witness get_issuer_secret(): Bytes<32>;

circuit assertIssuer(): [] {
  const secret = get_issuer_secret();
  const commitment = disclose(
    persistentHash<Vector<2, Bytes<32>>>([pad(32, "silent-quorum:issuer:"), secret])
  );
  assert(commitment == issuer_commitment, "not authorized issuer");
}

// ---- Registration: issuer admits a self-generated commitment. ----
// identityCommitment is generated by the participant off-chain (Model B) —
// the issuer calling this never sees the secret behind it.
export circuit register(identityCommitment: Bytes<32>): [] {
  assertIssuer();
  assert(registration_open, "registration closed");
  eligibility_tree.insert(disclose(identityCommitment));
}

// Irreversible. Calling this again is a harmless no-op (writes the same
// value), not an error — an M1 lesson: guarding idempotent state changes
// with an assert instead of a plain overwrite silently drops the whole
// transaction on legitimate repeats.
export circuit close_registration(): [] {
  assertIssuer();
  registration_open = false;
}

// Irreversible. Same no-op-on-repeat behavior as close_registration.
export circuit cancel(): [] {
  assertIssuer();
  cancelled = true;
}

// ---- Pledge: witness-held secret + path, never disclosed. ----
witness get_identity_secret(): Bytes<32>;
witness get_merkle_path(): MerkleTreePath<10, Bytes<32>>;

export circuit pledge(): [] {
  assert(!cancelled, "quorum cancelled");

  const secret = get_identity_secret();
  const path = get_merkle_path();

  // The path's embedded leaf must actually be this secret's commitment —
  // otherwise a witness could supply a disconnected (leaf, path) pair.
  const leaf = persistentHash<Vector<2, Bytes<32>>>([pad(32, "silent-quorum:leaf:"), secret]);
  assert(path.leaf == leaf, "path does not match secret");
  // Discloses only a value that must equal an already-public tree root if
  // valid — never which leaf/path produced it.
  const recomputedRoot = disclose(merkleTreePathRoot<10, Bytes<32>>(path));
  assert(eligibility_tree.checkRoot(recomputedRoot), "not eligible");

  const domain = persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "silent-quorum:domain:"), org_id, quorum_id, action_id]
  );
  const nullifier = disclose(
    persistentHash<Vector<2, Bytes<32>>>([secret, domain])
  );

  assert(!pledge_nullifiers.member(nullifier), "already pledged");
  pledge_nullifiers.insert(nullifier, true);

  tally.increment(1);

  // A pledge after firing is accepted and counted, but never re-fires — the
  // outer `if (!fired)`, not an assert, is what gives exactly-once its
  // guarantee (an assert here would revert, and thus drop, every honest
  // post-fire pledge — a real bug found in Milestone 1 testing).
  if (!fired) {
    if (tally as Uint<32> >= threshold) {
      fired = true;
      consequence_balance = consequence_amount;
    }
  }
}
